{
  "name": "mcp-msads",
  "version": "0.1.0",
  "description": "Microsoft Advertising (Bing Ads) MCP server — campaigns, keywords, audiences, reporting & keyword planning via natural language",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-msads": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun src/index.ts",
    "build": "bun build src/index.ts --compile --outfile=mcp-msads",
    "build:npm": "bun build src/index.ts --bundle --target node --outfile dist/index.js && node -e \"const f='dist/index.js';require('fs').writeFileSync(f,require('fs').readFileSync(f,'utf8').replace('#!/usr/bin/env bun','#!/usr/bin/env node'))\"",
    "prepublishOnly": "bun run build:npm && bun run version:check",
    "verify:package": "bun --no-env-file scripts/verify-package.ts",
    "version:check": "bun --no-env-file scripts/sync-version.ts --check",
    "version:sync": "bun --no-env-file scripts/sync-version.ts",
    "test": "bun --no-env-file scripts/run-hermetic-tests.ts",
    "test:live": "MSADS_RUN_LIVE_TESTS=true bun test tests/live",
    "test:live:prod": "MSADS_RUN_LIVE_TESTS=true MSADS_ENV_FILE=.env.production bun --env-file=.env.production test tests/live",
    "scan:secrets": "bun --no-env-file scripts/scan-secrets.ts",
    "test:cleanup": "bun scripts/cleanup-test-entities.ts",
    "test:cleanup:dry": "bun scripts/cleanup-test-entities.ts --dry-run",
    "typecheck": "tsc --noEmit",
    "setup": "bun src/index.ts setup",
    "setup:prod": "MSADS_ENV_FILE=.env.production bun --env-file=.env.production src/index.ts setup",
    "import:google": "bun scripts/import-google-credentials.ts",
    "inspect": "bunx @modelcontextprotocol/inspector bun src/index.ts",
    "format": "biome format --write .",
    "lint": "biome check .",
    "check": "biome check --write ."
  },
  "keywords": [
    "mcp",
    "microsoft-ads",
    "microsoft-advertising",
    "bing-ads",
    "ppc",
    "ai",
    "claude",
    "model-context-protocol",
    "bun"
  ],
  "author": "pijusz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pijusz/mcp-msads.git"
  },
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://github.com/pijusz/mcp-msads#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/bun": "1.4.3",
    "typescript": "7.0.2"
  },
  "mcpName": "io.github.pijusz/mcp-msads"
}
