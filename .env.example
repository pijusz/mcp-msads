# ─── Required ────────────────────────────────────────────────────────────────

# Developer token. Request one at https://ads.microsoft.com/cc/Settings/DevSettings
# (Super Admin credentials required). Not needed when MSADS_ENVIRONMENT=sandbox —
# the sandbox accepts the universal token BBD37VB98.
MSADS_DEVELOPER_TOKEN=your-developer-token

# Entra ID application (client) ID — a GUID from your app registration.
MSADS_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Client secret. Strongly recommended: a refresh token issued to a PUBLIC client
# is bound to the device that granted it and fails with invalid_grant anywhere
# else. Register a Web app with a secret if this server runs on a host other
# than the one you authorized on.
MSADS_CLIENT_SECRET=your-client-secret

# Long-lived refresh token from `mcp-msads setup`. Either this or
# MSADS_TOKEN_FILE must be set — there is no app-only auth for this API.
MSADS_REFRESH_TOKEN=your-refresh-token

# ─── Recommended ─────────────────────────────────────────────────────────────

# Path to the JSON token file `mcp-msads setup` writes. Preferred over
# MSADS_REFRESH_TOKEN: refresh tokens rotate on every use, and a file lets the
# server persist each rotation instead of holding it in memory only. Setup
# defaults to the owner-only platform config directory outside the checkout.
# Access tokens are never persisted.
# MSADS_TOKEN_FILE=/absolute/path/to/platform-config/mcp-msads/msads-token.json

# Default ad account, so tools don't need account_id on every call.
# MSADS_ACCOUNT_ID=123456789

# Default manager (customer) account. Resolved automatically when omitted.
# MSADS_CUSTOMER_ID=987654321

# ─── Optional ────────────────────────────────────────────────────────────────

# production (default) | sandbox. Credentials are NOT interchangeable between
# the two — using the wrong pair produces error 105 (InvalidCredentials).
# MSADS_ENVIRONMENT=production

# microsoft (default) | google — which provider owns the Microsoft Advertising
# user. Set google if the account signs in with Google, which is the usual case
# for sandbox accounts, since Microsoft-account sign-up needs an outlook.com
# address. A Google-owned user CANNOT be authenticated with a Microsoft token;
# MSADS_CLIENT_ID/SECRET must then come from a Google Cloud OAuth client.
# MSADS_IDENTITY_PROVIDER=google
# For Google, prefer a Desktop OAuth client for local setup. A Web client must
# register the exact loopback callback URI printed by setup.

# Entra authority tenant. `common` supports both personal and work accounts.
# MSADS_TENANT=common

# Probe the API once at startup so bad credentials surface immediately
# instead of on the first tool call.
# MSADS_VALIDATE_AT_STARTUP=true

# How long run_report waits before returning a resumable pending result (ms).
# MSADS_REPORT_TIMEOUT_MS=300000
# MSADS_REPORT_POLL_MS=2000

# How long bulk_download waits before returning a resumable pending result (ms).
# Bulk exports take minutes; the default is 10 of them.
# MSADS_BULK_TIMEOUT_MS=600000

# Per-HTTP-request timeout (ms) and retry budget for transient failures.
# MSADS_REQUEST_TIMEOUT_MS=60000
# MSADS_MAX_RETRIES=3

# error | warn | info | debug. Logs go to stderr; stdout is the MCP transport.
# MSADS_LOG_LEVEL=warn

# ─── Live integration tests (opt-in) ─────────────────────────────────────────

# Both are required before any live test will run. Opting in includes write
# tests: they create real entities (paused), delete them in the same run, and
# `bun run test:cleanup` sweeps anything a crash left behind.
# MSADS_RUN_LIVE_TESTS=true
# MSADS_TEST_ACCOUNT_ID=123456789

# Before sharing credentials created before the current secure setup flow,
# revoke the old provider grant and run setup again; deleting the file alone
# does not revoke access.
